#!/usr/bin/env bash
# cursor-safe-gui - Launch Cursor sandboxed with GUI support
# This wrapper handles being launched from desktop without arguments

# If launched with a directory argument, use it
if [ $# -ge 1 ] && [ -d "$1" ]; then
    exec cursor-safe "$1"
fi

# Default directory for dialog
DEFAULT_DIR="$HOME/Documents"
[ ! -d "$DEFAULT_DIR" ] && DEFAULT_DIR="$HOME"

# Show a GUI dialog to select directory (using kdialog for KDE)
SELECTED_DIR=$(kdialog --getexistingdirectory "$DEFAULT_DIR" "Select project directory to open in Cursor (sandboxed)" 2>/dev/null || echo "")

if [ -n "$SELECTED_DIR" ] && [ -d "$SELECTED_DIR" ]; then
    exec cursor-safe "$SELECTED_DIR"
else
    # User cancelled or kdialog failed - show error
    kdialog --error "No directory selected. Cursor requires a project directory to open." 2>/dev/null || true
    exit 0
fi
