#!/usr/bin/env bash
# turtlecode - Open VS Code Remote in a turtle container

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

log_error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }
log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }

if [ $# -lt 1 ]; then
    echo "Usage: turtlecode <container-name> [path-in-container]"
    echo ""
    echo "Open VS Code Remote in a turtle container."
    echo ""
    echo "Examples:"
    echo "  turtlecode turtle-myproject-123"
    echo "  turtlecode turtle-myproject-123 /workspace/myproject"
    echo ""
    echo "Available containers:"
    podman ps -a --filter "name=^turtle-" --format "  - {{.Names}}"
    exit 1
fi

CONTAINER_NAME="$1"
REMOTE_PATH="${2:-/workspace}"

# Check if container exists
if ! podman ps -a --format "{{.Names}}" | grep -q "^${CONTAINER_NAME}$"; then
    log_error "Container '${CONTAINER_NAME}' not found. Use 'turtlelist' to see available containers."
fi

# Check if container is running, start if not
if ! podman ps --format "{{.Names}}" | grep -q "^${CONTAINER_NAME}$"; then
    log_info "Container stopped. Starting..."
    podman start "$CONTAINER_NAME"
    sleep 2
fi

# Open VS Code Remote
log_info "Opening VS Code Remote..."
exec code --remote "container+${CONTAINER_NAME}" "$REMOTE_PATH"
