#!/usr/bin/env bash
# cursor-safe - Launch Cursor sandboxed to a specific directory

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: cursor-safe <directory>"
    echo ""
    echo "Launch Cursor sandboxed to only access the specified directory."
    echo ""
    echo "Examples:"
    echo "  cursor-safe ~/Documents/my-project"
    echo "  cursor-safe ."
    echo ""
    echo "Security:"
    echo "  - SSH keys, ~/.aws, ~/.gnupg, etc. are blacklisted"
    echo "  - AI chat cannot access parent directories"
    exit 1
fi

TARGET_DIR="$1"

# Resolve to absolute path
if [ "$TARGET_DIR" = "." ]; then
    TARGET_DIR="$PWD"
elif [[ ! "$TARGET_DIR" = /* ]]; then
    TARGET_DIR="$PWD/$TARGET_DIR"
fi

# Check if directory exists
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist"
    exit 1
fi

# Canonicalize path (removes trailing slash, resolves symlinks)
# Firejail rejects paths with trailing slashes as "invalid filename"
TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

# Launch cursor with firejail. Blacklists protect credentials; --read-only=$HOME
# breaks Electron on Wayland so we omit it (Cursor needs write access to various
# home dirs for init, extensions, etc).
exec firejail \
    --noprofile \
    --read-only=/nix/store \
    --private-tmp \
    --read-only=~/.ssh/known_hosts \
    --read-only=~/.ssh/config \
    --blacklist=~/.ssh/id_rsa \
    --blacklist=~/.ssh/id_ed25519 \
    --blacklist=~/.ssh/id_ecdsa \
    --blacklist=~/.aws \
    --blacklist=~/.gnupg \
    --blacklist=~/.password-store \
    --blacklist=~/.kube \
    --blacklist=~/.docker \
    --read-only=~/.1password \
    --caps.drop=all \
    --nonewprivs \
    --noroot \
    cursor "$TARGET_DIR"
