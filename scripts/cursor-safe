#!/usr/bin/env bash
# cursor-safe - Launch Cursor sandboxed to a specific directory

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: cursor-safe <directory>"
    echo ""
    echo "Launch Cursor sandboxed to only access the specified directory."
    echo ""
    echo "Examples:"
    echo "  cursor-safe ~/Documents/my-project"
    echo "  cursor-safe ."
    echo ""
    echo "Security:"
    echo "  - Only the specified directory is accessible"
    echo "  - ~/.ssh, ~/.aws, and other projects are blocked"
    echo "  - AI chat cannot access parent directories"
    exit 1
fi

TARGET_DIR="$1"

# Resolve to absolute path
if [ "$TARGET_DIR" = "." ]; then
    TARGET_DIR="$PWD"
elif [[ ! "$TARGET_DIR" = /* ]]; then
    TARGET_DIR="$PWD/$TARGET_DIR"
fi

# Check if directory exists
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist"
    exit 1
fi

# Launch cursor with bubblewrap (NixOS-compatible)
exec bwrap \
    --ro-bind /nix /nix \
    --dev /dev \
    --proc /proc \
    --tmpfs /tmp \
    --tmpfs /run \
    --ro-bind /sys /sys \
    --ro-bind-try /run/current-system /run/current-system \
    --ro-bind "$XDG_RUNTIME_DIR/wayland-0" "$XDG_RUNTIME_DIR/wayland-0" \
    --ro-bind-try "$XDG_RUNTIME_DIR/pulse" "$XDG_RUNTIME_DIR/pulse" \
    --ro-bind-try "$XDG_RUNTIME_DIR/pipewire-0" "$XDG_RUNTIME_DIR/pipewire-0" \
    --bind "$TARGET_DIR" "$TARGET_DIR" \
    --bind "$HOME/.cursor" "$HOME/.cursor" \
    --bind "$HOME/.config/Cursor" "$HOME/.config/Cursor" \
    --bind "$HOME/.cache/Cursor" "$HOME/.cache/Cursor" \
    --setenv HOME "$HOME" \
    --setenv XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR" \
    --setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY" \
    --setenv PATH "$PATH" \
    --unshare-pid \
    --die-with-parent \
    cursor "$TARGET_DIR"
