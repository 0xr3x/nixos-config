#!/usr/bin/env bash
# cursor-safe - Launch Cursor sandboxed to a specific directory

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: cursor-safe <directory>"
    echo ""
    echo "Launch Cursor sandboxed to only access the specified directory."
    echo ""
    echo "Examples:"
    echo "  cursor-safe ~/Documents/my-project"
    echo "  cursor-safe ."
    echo ""
    echo "Security:"
    echo "  - Only the specified directory is accessible"
    echo "  - ~/.ssh, ~/.aws, and other projects are blocked"
    echo "  - AI chat cannot access parent directories"
    exit 1
fi

TARGET_DIR="$1"

# Resolve to absolute path
if [ "$TARGET_DIR" = "." ]; then
    TARGET_DIR="$PWD"
elif [[ ! "$TARGET_DIR" = /* ]]; then
    TARGET_DIR="$PWD/$TARGET_DIR"
fi

# Check if directory exists
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist"
    exit 1
fi

# Launch cursor with firejail, whitelisting only the target directory
exec firejail \
    --noprofile \
    --read-only=/nix/store \
    --read-only="$HOME" \
    --private-tmp \
    --blacklist=~/.ssh \
    --blacklist=~/.aws \
    --blacklist=~/.gnupg \
    --blacklist=~/.password-store \
    --blacklist=~/.kube \
    --blacklist=~/.docker \
    --blacklist=~/.1password \
    --read-write="$TARGET_DIR" \
    --read-write=~/.cursor \
    --read-write=~/.config/Cursor \
    --read-write=~/.cache/Cursor \
    --caps.drop=all \
    --nonewprivs \
    --noroot \
    cursor "$TARGET_DIR"
