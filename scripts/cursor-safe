#!/usr/bin/env bash
# cursor-safe - Launch Cursor sandboxed to a specific directory

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: cursor-safe <directory>"
    echo ""
    echo "Launch Cursor sandboxed to only access the specified directory."
    echo ""
    echo "Examples:"
    echo "  cursor-safe ~/Documents/my-project"
    echo "  cursor-safe ."
    echo ""
    echo "Security:"
    echo "  - Only the specified directory is accessible"
    echo "  - ~/.ssh, ~/.aws, and other projects are blocked"
    echo "  - AI chat cannot access parent directories"
    exit 1
fi

TARGET_DIR="$1"

# Resolve to absolute path
if [ "$TARGET_DIR" = "." ]; then
    TARGET_DIR="$PWD"
elif [[ ! "$TARGET_DIR" = /* ]]; then
    TARGET_DIR="$PWD/$TARGET_DIR"
fi

# Check if directory exists
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Directory '$TARGET_DIR' does not exist"
    exit 1
fi

# Launch cursor with firejail
# Use --private-home to create isolated home with only what we need
exec firejail \
    --profile=/etc/firejail/cursor.profile \
    --private-home=.cursor,.config/Cursor,.cache/Cursor \
    --whitelist="$TARGET_DIR" \
    cursor "$TARGET_DIR"
