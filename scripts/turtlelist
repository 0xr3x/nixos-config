#!/usr/bin/env bash
# turtlelist - List all turtle containers and their status

set -euo pipefail

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}🐢 Turtle Containers${NC}"
echo ""

# Get all containers with "turtle-" prefix
CONTAINERS=$(podman ps -a --filter "name=^turtle-" --format "{{.Names}}\t{{.Status}}\t{{.CreatedHuman}}" 2>/dev/null)

if [ -z "$CONTAINERS" ]; then
    echo "No turtle containers found."
    echo ""
    echo "Create one with: turtleclone <git-url>"
    exit 0
fi

echo -e "${GREEN}Active Containers:${NC}"
printf "%-40s %-20s %-20s\n" "NAME" "STATUS" "CREATED"
echo "────────────────────────────────────────────────────────────────────────────"

while IFS=$'\t' read -r name status created; do
    if [[ "$status" == Up* ]]; then
        STATUS_COLOR=$GREEN
    else
        STATUS_COLOR=$YELLOW
    fi
    printf "%-40s ${STATUS_COLOR}%-20s${NC} %-20s\n" "$name" "$status" "$created"
done <<< "$CONTAINERS"

echo ""
echo "Commands:"
echo "  Enter container:  podman exec -it <name> bash"
echo "  Stop container:   podman stop <name>"
echo "  Remove container: turtlenuke <name>"
