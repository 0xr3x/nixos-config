#!/usr/bin/env bash
# turtlenuke - Destroy a turtle container and its volume

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

if [ $# -lt 1 ]; then
    echo "Usage: turtlenuke <container-name>"
    echo ""
    echo "This will:"
    echo "  1. Stop the container"
    echo "  2. Remove the container"
    echo "  3. Remove the associated volume (ALL DATA WILL BE LOST)"
    echo ""
    echo "Available containers:"
    podman ps -a --filter "name=^turtle-" --format "  - {{.Names}}"
    exit 1
fi

CONTAINER_NAME="$1"

# Check if container exists
if ! podman ps -a --format "{{.Names}}" | grep -q "^${CONTAINER_NAME}$"; then
    echo -e "${RED}Error:${NC} Container '${CONTAINER_NAME}' not found"
    exit 1
fi

echo -e "${YELLOW}⚠️  WARNING${NC}"
echo "You are about to destroy: ${CONTAINER_NAME}"
echo "This will delete ALL data in the container and its volume."
echo ""
read -p "Are you sure? (yes/no): " -r
echo

if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
    echo "Cancelled."
    exit 0
fi

# Find associated volume
VOLUME_NAME="${CONTAINER_NAME}-data"

echo -e "${GREEN}Stopping container...${NC}"
podman stop "$CONTAINER_NAME" 2>/dev/null || true

echo -e "${GREEN}Removing container...${NC}"
podman rm "$CONTAINER_NAME"

echo -e "${GREEN}Removing volume...${NC}"
if podman volume exists "$VOLUME_NAME" 2>/dev/null; then
    podman volume rm "$VOLUME_NAME"
else
    echo "  (no volume found)"
fi

echo ""
echo -e "${GREEN}✅ Container destroyed${NC}"
