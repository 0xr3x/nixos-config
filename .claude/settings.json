{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(nix eval:*)",
      "Bash(nix flake metadata:*)",
      "Bash(nix flake show:*)",
      "Bash(nix search:*)",
      "Bash(nix-instantiate --parse:*)",
      "Bash(nixos-option:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(eza:*)",
      "Bash(bat:*)",
      "Bash(systemctl status:*)",
      "Bash(systemctl list-units:*)",
      "Bash(journalctl:*)",
      "Bash(lsusb:*)",
      "Bash(lspci:*)",
      "Bash(podman ps:*)",
      "Bash(podman images:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.1password/**)",
      "Read(~/.config/1Password/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)"
    ]
  }
}
